# Docker Compose 环境变量(被 .gitignore 忽略,切勿提交)
# docker compose 读取与 compose 文件同目录的 .env 来解析 ${...}

# ── Google Calendar 集成(OAuth 单一账号:infotech@aranya.sg)──
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_AUTH_MODE=OAUTH

# 两个共享日历:格式 id1|显示名1;id2|显示名2 (分号分隔两个,竖线分隔 id 与名称)
# 把下面替换成你的两个 Calendar ID 与想显示的名字
GOOGLE_CALENDAR_LIST=EXAMPLE
# 默认写入哪个日历(填上面其中一个的 Calendar ID)
GOOGLE_CALENDAR_DEFAULT_ID=EXAMPLE

# 下面三项填你从 OAuth Playground 拿到的值(勿加引号)
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=EXAMPLE
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=EXAMPLE
GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN=EXAMPLE

# ── Case 文件存储(GCS) ──
# 本地上传不会存到 repo 目录;会写入这个 bucket:
# gs://<GCS_BUCKET_NAME>/cases/{caseId}/documents/{documentId}/...
FILE_STORAGE_MAX_UPLOAD_SIZE_MB=25
GCS_BUCKET_NAME=EXAMPLE
GCS_SIGNED_URL_TTL_MINUTES=10
# Windows 路径建议用正斜杠并加双引号,尤其路径含空格或撇号时。
GCS_CREDENTIALS_HOST_PATH="D:/path/to/gcs-service-account.json"
